{
  "buildCommand": "bash build.sh && python3 scripts/apply_x_viral_loop.py && python3 scripts/patch_og_node_require.py",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {"source": "/r/:id", "destination": "/api/event?action=result-page&id=:id"},
    {"source": "/og/:id", "destination": "/api/event?action=result-og&id=:id"},
    {"source": "/api/python-scan", "destination": "/api/python_scan"}
  ],
  "redirects": [
    {"source": "/suspicious-text-message-link", "destination": "/sms-link-checker", "permanent": true},
    {"source": "/is-this-email-safe", "destination": "/email-safety-checker", "permanent": true},
    {"source": "/check-google-drive-link", "destination": "/google-drive-link-checker", "permanent": true},
    {"source": "/google-drive-share-link-test", "destination": "/google-drive-link-checker", "permanent": true},
    {"source": "/check-dropbox-link", "destination": "/dropbox-link-checker", "permanent": true},
    {"source": "/will-my-dropbox-link-work", "destination": "/dropbox-link-checker", "permanent": true},
    {"source": "/how-to-check-a-link-without-clicking-it", "destination": "/how-to-check-if-a-link-is-safe", "permanent": true}
  ],
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "no-referrer"},
      {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"}
    ]},
    {"source": "/api/(.*)", "headers": [
      {"key": "Cache-Control", "value": "no-store"}
    ]}
  ]
}
